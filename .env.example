# API the web app talks to
VITE_API_URL=http://localhost:5173/api

# Public site URL (used for canonical links, social cards and the sitemap)
VITE_SITE_URL=https://lotnis.com

# MapTiler Cloud key — enables the map, address search and the map pin on the host form.
# Create one at https://cloud.maptiler.com/account/keys/ and restrict it to your site's domains.
# Leave blank to run without maps: hosts pick region + town from the shared list instead.
VITE_MAPTILER_KEY=

VITE_PAYSTACK_PUBLIC_KEY=
VITE_SUPABASE_URL=
