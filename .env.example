# API the web app talks to
VITE_API_URL=http://localhost:3000/api

# Public site URL (used for canonical links, social cards and the sitemap)
VITE_SITE_URL=https://lotnis.com

# Google Maps Platform key — enables address search, the map pin on the host form,
# "near a place" search and the map view. Enable these APIs on the key:
#   Maps JavaScript API · Places API (New) · Geocoding API
# Restrict it to your site's HTTP referrers (and set a budget alert) in Google Cloud.
# Leave blank to run without maps: hosts pick region + city from the shared list instead.
VITE_GOOGLE_MAPS_API_KEY=

VITE_PAYSTACK_PUBLIC_KEY=
VITE_SUPABASE_URL=
