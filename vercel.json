{
  "rewrites": [
    {
      "source": "/events/:slug/vote/:cat/:nominee",
      "destination": "/api/share?slug=:slug&cat=:cat&nominee=:nominee"
    },
    {
      "source": "/events/:slug/vote/:cat",
      "destination": "/api/share?slug=:slug&cat=:cat"
    },
    {
      "source": "/events/:slug",
      "destination": "/api/share?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
